{
  "$schema": "https://pi-web.dev/schema/pi-web.json",
  "id": "blksails/agic-video-agent",
  "version": "0.1.0",
  "kind": "agent",
  "displayName": "Agent 视频工作室",
  "description": "workflow-first 视频创作：创意简报→镜头方案→逐镜头视频生成/实时暂停与人工介入→预览导出；复用搜图、素材、画布及视频/TTS/ffmpeg 工具。",
  "files": [
    "attachment-catalog.ts",
    "persist-extension.ts",
    "platform-client.ts",
    "platform-keys.ts",
    "extensions/**/*.ts",
    "routes/**/*.ts",
    "media-tools/src/**/*.ts",
    "media-tools/package.json",
    "panes/pane-documents.generated.ts",
    "video-studio/**/*.ts",
    "video-studio/**/*.tsx"
  ]
}
