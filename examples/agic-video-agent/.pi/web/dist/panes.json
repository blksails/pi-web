{
  "id": "agic-video-panes",
  "config": {
    "panelRatio": "centered",
    "panelWidth": 620,
    "minPanelWidth": 320,
    "maxPanelWidth": 960,
    "maxPanelWidthRatio": 0.7,
    "interactionMode": "advanced",
    "allowTabReorder": true,
    "showCommandPalette": true,
    "eventTargets": {
      "pi.canvas.open-attachments": "canvas"
    }
  },
  "panes": [
    {
      "id": "search",
      "title": "搜图",
      "icon": "search",
      "capabilities": {
        "routes": [
          {
            "name": "creative-search",
            "methods": [
              "POST"
            ]
          }
        ],
        "surfaceKeys": [],
        "surfaceCommands": [],
        "events": {
          "publish": [],
          "subscribe": []
        },
        "attachments": "none",
        "conversation": "none"
      }
    },
    {
      "id": "materials",
      "title": "素材",
      "icon": "images",
      "capabilities": {
        "routes": [
          {
            "name": "assets-list",
            "methods": [
              "GET"
            ]
          },
          {
            "name": "materials-library",
            "methods": [
              "GET",
              "POST"
            ]
          },
          {
            "name": "material-status",
            "methods": [
              "GET"
            ]
          }
        ],
        "surfaceKeys": [
          "surface:materials"
        ],
        "surfaceCommands": [
          {
            "domain": "materials",
            "actions": [
              "select",
              "set-filter",
              "create-folder",
              "rename-folder",
