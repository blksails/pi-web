{
  "$schema": "https://pi-web.dev/schema/pi-web.json",
  "id": "blksails/aigc-studio",
  "version": "0.1.1",
  "kind": "agent",
  "displayName": "AIGC 图像工作台",
  "description": "图像生成/编辑 + 视频·TTS·ffmpeg 媒体工具族;右栏三业务域(搜图/素材/画布)为隔离 iframe pane(panes-kit),输入区带分栏工具菜单。宿主提供 @blksails/pi-web-*,本源不 bundle 依赖。webext 产物走 .pi/web/dist 约定探测(需先跑 build.ts)。",
  "files": [
    "attachment-catalog.ts",
    "persist-extension.ts",
    "platform-client.ts",
    "platform-keys.ts",
    "panes/**/*.ts",
    "routes/**/*.ts",
    "media-tools/src/**/*.ts",
    "media-tools/package.json",
    "web/panes/index.ts",
    "web/pane-documents.generated.ts"
  ]
}
