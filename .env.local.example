# pi-web app shell — environment configuration sample.
# Copy to `.env.local` and fill in. Values are read at runtime by lib/app/config.ts
# and are NEVER logged, echoed to the client, or placed in error responses.

# ── Credentials & defaults come from ~/.pi/agent by default ───────────────────
# pi-web spawns the agent process (custom-agent runner or `pi --mode rpc`), which
# reads your pi config dir:
#   ~/.pi/agent/auth.json     → API keys / OAuth tokens stored by `pi` login
#   ~/.pi/agent/settings.json → default provider/model, installed packages, theme
# So if you've run `pi` and logged in, NO env provider key is required, and the
# default model/provider come from settings.json (the UI honors your pi config).

# ── Provider API keys (OPTIONAL, additive passthrough) ────────────────────────
# Only needed to override / supplement ~/.pi/agent/auth.json. Passed through to
# the agent process via env. Leave blank to rely on auth.json.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# ── pi config dir override (OPTIONAL) ─────────────────────────────────────────
# Defaults to ~/.pi/agent. Set to isolate per-tenant config (auth/settings/sessions).
# PI_WEB_AGENT_DIR=/abs/path/to/agent-dir
# (PI_CODING_AGENT_DIR is also honored, matching pi's own env var.)

# ── Session-creation defaults (OPTIONAL overrides) ────────────────────────────
# Leave UNSET to let ~/.pi/agent/settings.json decide the provider/model.
# Set only to force a specific model regardless of settings.json.
# PI_WEB_DEFAULT_PROVIDER=openrouter
# PI_WEB_DEFAULT_MODEL=anthropic/claude-sonnet-4.6

# Hide specific providers from the settings model/provider dropdown (OPTIONAL).
# Comma-separated provider names; their models are filtered out of the
# GET /config/models data endpoint, so they never appear in the UI dropdown.
# PI_WEB_HIDE_PROVIDERS=anthropic,openai

# Default agent source offered by the picker (a directory with index.ts for a
# custom agent, any directory for general CLI mode, or a git source).
# PI_WEB_DEFAULT_SOURCE=./examples/hello-agent

# Default working directory for sessions (defaults to the server cwd).
# PI_WEB_DEFAULT_CWD=

# ── e2e / offline ────────────────────────────────────────────────────────────
# Set to 1 to run every session against a deterministic local stub agent that
# speaks the RPC JSONL protocol. No API key required. Used by Playwright e2e and
# the Node-level streaming e2e for offline determinism.
# PI_WEB_STUB_AGENT=1

# 视觉识别默认模型（image_vision）。格式 provider/modelId，须在 models.json 中且 input 含 image。
# 建议始终配置：无人值守通道（IM/定时任务）hasUI 亦为 true，不配会弹层等人点选而永久挂起。
# PI_WEB_VISION_MODEL=apiservices/gpt-5.4

# ── ai-gateway providers (OPTIONAL, spec ai-gateway-providers) ────────────────
# Single enable switch: setting AI_GATEWAY_BASE_URL mounts /api/ai-gateway/*
# (key-exchange forwarding), aggregates the gateway model catalog, and adds the
# gateway AIGC image routes. Unset/blank = fully disabled (zero registration).
# Restart dev after changing (handler singleton is pinned in globalThis).
# AI_GATEWAY_BASE_URL=http://127.0.0.1:8080
# Platform sk-gw key, read per-request (swap in place without restart).
# AI_GATEWAY_API_KEY=
# Signing secret for scope="ai-gateway" session tokens. REQUIRED when enabled
# unless PI_WEB_ATTACHMENT_SECRET is set (assembly fails fast otherwise).
# PI_WEB_AI_GATEWAY_SECRET=
# Optional overrides (defaults in packages/server/src/ai-gateway/config.ts):
# AI_GATEWAY_TIMEOUT_MS=120000
# AI_GATEWAY_CATALOG_TTL_MS=300000
# PI_WEB_AI_GATEWAY_MODEL_PRECEDENCE=gateway   # duplicate-name winner: gateway | self
# Only needed for e2b sandboxes to reach ai-gateway (sandbox-reachable base):
# PI_WEB_LLM_GATEWAY_PUBLIC_BASE=

# ── Multi-gateway instances (spec multi-gateway-providers) ────────────────────
# The single-instance vars above still work and synthesize a default instance
# whose id is `ai-gateway` (byte-compatible with pre-change behaviour).
#
# To run SEVERAL gateways side by side — e.g. Cloudflare AI Gateway and the
# BlackSail self-hosted one — list their ids and configure each one. The id IS
# the provider name shown in the UI, so `cloudflare` and `blksails-ai` appear as
# two distinct providers instead of collapsing into one opaque `ai-gateway`.
#
# PI_WEB_GATEWAYS=cloudflare,blksails-ai
#
# Per-instance vars: <ID> = id upper-cased with `-` replaced by `_`
# (same derivation as PI_LLM_TOKEN_<ID>).
# PI_WEB_GATEWAY_CLOUDFLARE_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gw>/compat
# PI_WEB_GATEWAY_CLOUDFLARE_API_KEY=
# PI_WEB_GATEWAY_CLOUDFLARE_ALLOWLIST=anthropic,openai,google-ai-studio
# PI_WEB_GATEWAY_CLOUDFLARE_TTL_MS=300000
# PI_WEB_GATEWAY_CLOUDFLARE_TIMEOUT_MS=120000
# PI_WEB_GATEWAY_CLOUDFLARE_INPUT=text,image     # modality of this instance's models
# PI_WEB_GATEWAY_CLOUDFLARE_OUTPUT=text
#
# PI_WEB_GATEWAY_BLKSAILS_AI_BASE_URL=http://127.0.0.1:8080
# PI_WEB_GATEWAY_BLKSAILS_AI_API_KEY=
#
# ! PI_WEB_AI_GATEWAY_SECRET (or the PI_WEB_ATTACHMENT_SECRET fallback) is REQUIRED
#   here too. Enabling ANY instance — via PI_WEB_GATEWAYS or the single-instance
#   AI_GATEWAY_BASE_URL above — makes assembly resolve the scoped-token signing
#   secret; with neither set the server throws AT STARTUP. Configuring only this
#   section and skipping the secret line above is a startup crash, not a degraded
#   mode. (Verified: see the gateways webServer env note in playwright.config.ts.)
#
# ! Instance ids must be unique across ALL provider sources. A collision fails
#   fast at startup listing every conflicting id — it is never resolved silently.
#
# Session side (what the runner subprocess registers as usable providers) is a
# SEPARATE list, wired by the assembly layer:
# PI_WEB_AI_GATEWAY_SESSIONS=cloudflare,blksails-ai
# PI_WEB_AI_GATEWAY_SESSION_<ID>_{BASE,KEY,MODELS}
#
# ! The runner reads PI_WEB_AI_GATEWAY_SESSIONS to decide which instance names get
#   source-specific "model not found" guidance. Without it, a failure on a
#   non-default instance falls back to the bare registry message.

# ── Cloudflare AI Gateway image provider (spec cloudflare-aigc-provider) ──────
# All three must be non-empty to register the `cloudflare` image models;
# if any is missing the provider is not offered at all (rather than failing at call time).
# Requires a dev restart: the conditional registration reads env at aigcExtension assembly time.
#
# ! Do NOT rename the token var to AI_GATEWAY_API_KEY — that name is the pi-ai SDK's built-in
#   Vercel AI Gateway credential env; its presence in a pi co-process hijacks *all* model calls
#   (401), not just the image tools. Same reason BLKSAILS_GATEWAY_* was renamed.
#
# Unified billing: calling openai/* and other third-party models needs only the Cloudflare
# credential — no separate OpenAI key (keySource=Unified).
# CLOUDFLARE_ACCOUNT_ID=<cloudflare account id>
# CLOUDFLARE_AIG_GATEWAY_ID=<ai gateway name>
# Prefer a long-lived API Token from the Cloudflare dashboard (needs Account > AI Gateway).
# A `wrangler auth token` OAuth token (cfoat_ prefix) also works but expires.
# CLOUDFLARE_API_TOKEN=<cloudflare api token>
# Optional outbound proxy for both the API request and the generated-image download.
# Needed where api.cloudflare.com / *.r2.cloudflarestorage.com time out on a direct connection.
# (curl reads HTTPS_PROXY; node's undici fetch does NOT — so it must be set explicitly here.)
# CLOUDFLARE_PROXY=http://127.0.0.1:10808
